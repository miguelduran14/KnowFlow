{
  "name": "knowflow",
  "version": "0.1.1",
  "description": "COBOL comprehension and onboarding tool — parse deterministically, explain with AI",
  "license": "Apache-2.0",
  "author": "Miguel Durán (https://github.com/miguelduran14)",
  "homepage": "https://github.com/miguelduran14/KnowFlow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miguelduran14/KnowFlow.git"
  },
  "bugs": {
    "url": "https://github.com/miguelduran14/KnowFlow/issues"
  },
  "keywords": [
    "cobol",
    "mainframe",
    "legacy-code",
    "static-analysis",
    "code-comprehension",
    "parser",
    "copybook",
    "db2",
    "cics",
    "developer-tools"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "knowflow": "./dist/cli.js"
  },
  "files": [
    "dist",
    "gui/dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && npm run build --prefix gui",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  }
}
