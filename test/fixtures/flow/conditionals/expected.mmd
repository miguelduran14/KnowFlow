flowchart TD
  MAIN_PARA["MAIN-PARA"]
  INIT_PARA["INIT-PARA"]
  PATH_A["PATH-A"]
  PATH_B["PATH-B"]
  DO_A["DO-A"]
  DO_BC["DO-BC"]
  DO_REST["DO-REST"]
  MID_PARA["MID-PARA"]
  CLOSE_PARA["CLOSE-PARA — fin"]
  SUBPRG[["SUBPRG"]]
  MAIN_PARA -->|"PERFORM"| INIT_PARA
  MAIN_PARA -->|"[WS-FLAG = 'Y'] PERFORM"| PATH_A
  MAIN_PARA -->|"[NOT (WS-FLAG = 'Y')] PERFORM"| PATH_B
  MAIN_PARA -->|"[WS-TIPO = 'A'] PERFORM"| DO_A
  MAIN_PARA -->|"[WS-TIPO = 'B' OR WS-TIPO = 'C'] PERFORM"| DO_BC
  MAIN_PARA -->|"[WHEN OTHER] PERFORM"| DO_REST
  MAIN_PARA -->|"PERFORM"| CLOSE_PARA
  INIT_PARA -->|"[WS-COUNT > 0 AND WS-READY = 'Y' AND WS-DEEP = 1] CALL"| SUBPRG
  INIT_PARA -->|"[WS-COUNT > 0 AND WS-READY = 'Y'] PERFORM"| MID_PARA
